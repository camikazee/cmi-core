{
    "name": "cmi/core",
    "description": "Reusable Symfony core utilities for audit logging, lightweight scheduling, dictionary seeding and notification templates.",
    "type": "symfony-bundle",
    "license": "MIT",
    "keywords": [
        "symfony",
        "bundle",
        "audit",
        "scheduler",
        "dictionary",
        "notifications"
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "api-platform/core": "^4.2 || ^4.3",
        "doctrine/dbal": "^4.0",
        "doctrine/doctrine-bundle": "^2.13",
        "doctrine/orm": "^3.0",
        "php": "^8.2",
        "psr/log": "^3.0",
        "symfony/config": "^7.4",
        "symfony/console": "^7.4",
        "symfony/dependency-injection": "^7.4",
        "symfony/http-client": "^7.4",
        "symfony/http-foundation": "^7.4",
        "symfony/http-kernel": "^7.4",
        "symfony/lock": "^7.4",
        "symfony/mime": "^7.4",
        "symfony/security-core": "^7.4",
        "symfony/uid": "^7.4",
        "symfony/yaml": "^7.4",
        "twig/twig": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "symfony/framework-bundle": "^7.4"
    },
    "config": {
        "preferred-install": {
            "*": "dist"
        },
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "Core\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Core\\Tests\\": "tests/"
        }
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.x-dev"
        },
        "symfony": {
            "require": "7.4.*"
        }
    }
}
